{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Study Specification",
  "type": "object",
  "required": [
    "study_title",
    "study_design",
    "research_question",
    "population",
    "variables"
  ],
  "properties": {
    "study_title": {
      "type": "string",
      "minLength": 3
    },
    "study_design": {
      "enum": [
        "observational_cohort",
        "case_control",
        "cross_sectional",
        "randomized_trial",
        "diagnostic_accuracy",
        "case_series",
        "registry_longitudinal"
      ]
    },
    "research_question": {
      "type": "string",
      "minLength": 10
    },
    "population": {
      "type": "object",
      "required": [
        "target_population",
        "inclusion_criteria",
        "exclusion_criteria"
      ]
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "data_type",
          "definition"
        ]
      }
    }
  }
}