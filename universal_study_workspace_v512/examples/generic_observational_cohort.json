    },
    {
      "name": "exposure_group",
      "role": "exposure",
      "data_type": "category",
      "definition": "Baseline exposure classification",
      "allowed_values": [
        "exposed",
        "unexposed"
      ]
    },
    {
      "name": "outcome_event",
      "role": "outcome",
      "data_type": "boolean",
      "definition": "Whether the prespecified event occurred"
    },
    {
      "name": "age_years",
      "role": "covariate",
      "data_type": "integer",
      "unit": "years",
      "definition": "Age at index date"
    }
  ]
