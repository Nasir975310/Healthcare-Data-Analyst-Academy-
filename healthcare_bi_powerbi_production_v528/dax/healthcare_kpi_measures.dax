DimDate = ADDCOLUMNS(CALENDAR(DATE(2026,1,1),DATE(2026,12,31)), "Year",YEAR([Date]), "Month No",MONTH([Date]), "Month",FORMAT([Date],"MMM"), "Year-Month",FORMAT([Date],"YYYY-MM"))

Patients = DISTINCTCOUNT(DimPatient[PatientID])
Encounters = DISTINCTCOUNT(FactEncounter[EncounterID])
Completed Encounters = CALCULATE([Encounters],FactEncounter[Status]="Completed")
Medication Orders = DISTINCTCOUNT(FactMedication[MedicationID])
Average Medications per Encounter = DIVIDE([Medication Orders],[Encounters])
Mean Systolic BP = CALCULATE(AVERAGE(FactObservation[Value]),FactObservation[Measure]="Systolic BP")
Mean Diastolic BP = CALCULATE(AVERAGE(FactObservation[Value]),FactObservation[Measure]="Diastolic BP")
Systolic Readings >= 140 = CALCULATE(COUNTROWS(FactObservation),FactObservation[Measure]="Systolic BP",FactObservation[Value]>=140)
Systolic Readings = CALCULATE(COUNTROWS(FactObservation),FactObservation[Measure]="Systolic BP")
Systolic Readings >= 140 (%) = DIVIDE([Systolic Readings >= 140],[Systolic Readings])
Encounters YTD = TOTALYTD([Encounters],DimDate[Date])
Encounters Previous Month = CALCULATE([Encounters],DATEADD(DimDate[Date],-1,MONTH))
Encounter MoM Change (%) = DIVIDE([Encounters]-[Encounters Previous Month],[Encounters Previous Month])
Drug Class Share (%) = DIVIDE([Medication Orders],CALCULATE([Medication Orders],REMOVEFILTERS(FactMedication[DrugClass])))
